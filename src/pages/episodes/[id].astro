---
export const prerender = true;

import { getCollection, getEntry, render } from 'astro:content';
import { getEpisodeImage } from '../../lib/images';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  return episodes.map((episode) => ({
    params: { id: episode.id },
  }));
}

const { id } = Astro.params;
const episode = await getEntry('episodes', id);

if (!episode) {
  return Astro.redirect('/404');
}

const { title, pubDate, shortDescription, imageUrl, duration, audioSource } = episode.data;
const audioUrl = audioSource.url;
const cover = await getEpisodeImage(imageUrl);

const podcastConfig = await getEntry('podcast', 'config');
const lang = podcastConfig?.data.appLanguage ?? 'es';
const { applePodcastId, spotifyShowId, youtubeHandle } = podcastConfig?.data ?? {};

const { Content } = await render(episode);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={shortDescription} />
  </head>
  <body>
    <a href="/">&larr; Volver</a>

    <article>
      <img src={cover} alt={title} width="600" />
      <h1>{title}</h1>
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <span> · {duration}</span>

      <audio controls preload="metadata" src={audioUrl} />

      <nav aria-label="Suscribirse al podcast">
        <h2>Suscribirse</h2>
        <ul>
          <li><a href="/feed.xml">RSS</a></li>
          {applePodcastId && <li><a href={`https://podcasts.apple.com/podcast/id${applePodcastId}`} target="_blank" rel="noopener">Apple Podcasts</a></li>}
          {spotifyShowId && <li><a href={`https://open.spotify.com/show/${spotifyShowId}`} target="_blank" rel="noopener">Spotify</a></li>}
          {youtubeHandle && <li><a href={`https://www.youtube.com/@${youtubeHandle}`} target="_blank" rel="noopener">YouTube</a></li>}
        </ul>
      </nav>

      <section class="content">
        <Content />
      </section>
    </article>
  </body>
</html>
