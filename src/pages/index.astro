---
export const prerender = true;

import { getCollection, getEntry } from 'astro:content';
import { getEpisodeImage } from '../lib/images';

// Configuración global del podcast
const podcastConfig = await getEntry('podcast', 'config');
const { title, description, homeItemsPerPage, appLanguage, coverImage } = podcastConfig.data;

// Episodios publicados, ordenados por fecha descendente
const allEpisodes = await getCollection('episodes', ({ data }) => {
  return data.status === 'published';
});

const episodes = allEpisodes
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, homeItemsPerPage);
---

<html lang={appLanguage}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<img src={coverImage} alt={title} width="300" />
		<h1>{title}</h1>
		<p>{description}</p>
		<hr />
		<section>
			{episodes.length === 0 && <p>No hay episodios publicados aún.</p>}

			{episodes.map(async (episode) => {
				const { title, pubDate, shortDescription, imageUrl, duration, audioSource } = episode.data;
				const audioUrl = audioSource.url;
				const cover = await getEpisodeImage(imageUrl);

				return (
					<article style="display: flex; gap: 10px;">
					<div>
						<a href={`/episodes/${episode.id}`}>
							<img src={cover} alt={title} height="150" />
						</a>
					</div>
					<div>
							<h2>{title}</h2>
						<time datetime={pubDate.toISOString()}>
							{pubDate.toLocaleDateString(appLanguage, { year: 'numeric', month: 'long', day: 'numeric' })}
						</time>
						<span> · {duration}</span>
						<p>{shortDescription}</p>
						<audio controls preload="none" src={audioUrl} />
					</div>
					</article>
				);
			})}
		</section>
	</body>
</html>
